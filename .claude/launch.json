{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["backend.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "frontend-mock",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd frontend && VITE_USE_MOCK=1 npm run dev -- --port 5173 --strictPort"],
      "port": 5173
    }
  ]
}
