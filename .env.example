# Copy to .env and fill in. Never commit .env.
TINYFISH_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
# Seconds per Gemini attempt before trying the fallback model (then the rule-based path)
LLM_TIMEOUT_S=40
# 1 serves a recorded run from backend/cache/replay/ instead of live calls
REPLAY=0
